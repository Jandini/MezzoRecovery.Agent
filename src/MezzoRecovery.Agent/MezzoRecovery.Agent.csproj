<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MezzoRecovery.Agent</RootNamespace>
    <AssemblyName>mra</AssemblyName>
    <Description>MezzoRecovery Linux recovery host agent (Stage 3)</Description>
    <Authors>Matt Janda</Authors>
    <RepositoryUrl>https://github.com/Jandini/MezzoRecovery.Agent</RepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MezzoRecovery.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.Json" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.*" />
    <PackageReference Include="System.CommandLine" Version="2.0.2" />
  </ItemGroup>

	<PropertyGroup>
		<OwnSolutionName>MezzoRecovery.Agent</OwnSolutionName>
		<UseProjectReference Condition=" '$(SolutionName)' != '' and '$(SolutionName)' != '$(OwnSolutionName)' ">true</UseProjectReference>
	</PropertyGroup>

	<PropertyGroup>
		<MezzoRecoveryTapeDriveProject>../../../MezzoRecovery.TapeDrive/src/MezzoRecovery.TapeDrive/MezzoRecovery.TapeDrive.csproj</MezzoRecoveryTapeDriveProject>
		<MezzoRecoveryTapeProject>../../../MezzoRecovery.Tape/src/MezzoRecovery.Tape/MezzoRecovery.Tape.csproj</MezzoRecoveryTapeProject>
	</PropertyGroup>

	<ItemGroup Condition=" '$(UseProjectReference)' == 'true' ">
		<ProjectReference Include="$(MezzoRecoveryTapeDriveProject)" Condition="Exists($(MezzoRecoveryTapeDriveProject))" />
		<ProjectReference Include="$(MezzoRecoveryTapeProject)" Condition="Exists($(MezzoRecoveryTapeProject))" />
	</ItemGroup>

	<ItemGroup Condition=" '$(UseProjectReference)' != 'true' ">
		<ProjectReference Include="$(MezzoRecoveryTapeDriveProject)" Condition="Exists($(MezzoRecoveryTapeDriveProject))" />
		<ProjectReference Include="$(MezzoRecoveryTapeProject)" Condition="Exists($(MezzoRecoveryTapeProject))" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MezzoRecovery.TapeDrive" Version="0.1.1-preflight.10" Condition="!Exists($(MezzoRecoveryTapeDriveProject))" />
		<PackageReference Include="MezzoRecovery.Tape" Version="0.1.0-preflight.18" Condition="!Exists($(MezzoRecoveryTapeProject))" />
	</ItemGroup>

</Project>
